# Conexão com o PostgreSQL do docker-compose.yml.
#
# PGPORT é lido pelo compose (porta publicada no host) E pela aplicação (porta
# de destino) — uma fonte de verdade só. O padrão é 55432 porque a 5432 costuma
# estar ocupada; se a 55432 também estiver, troque apenas esta linha.
PGHOST=localhost
PGPORT=55432
PGUSER=wagering
PGPASSWORD=wagering
PGDATABASE=wagering

# LocalStack. Credenciais são fictícias por definição — o LocalStack não valida
# assinatura, e nenhum segredo real entra neste arquivo.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Fila de SAÍDA dos eventos de integração (D-040). O enunciado nomeia só as
# filas de entrada; o destino da publicação da outbox foi decidido aqui. O
# sufixo .fifo não é cosmético: é ele que faz a fila ser criada como FIFO e que
# torna o MessageGroupId obrigatório em cada publicação.
# Ninguém precisa criá-la à mão — o worker a provisiona de forma idempotente na
# primeira publicação, pelo mesmo módulo que o preload de teste usa (D-041).
SQS_EVENTS_QUEUE=wagering-events.fifo

# Retry, backoff e lease da outbox (D-008, D-009, D-022, D-042).
#
# Defaults conservadores de propósito: numa máquina lenta, valores agressivos
# produziriam republicação e leriam como instabilidade do sistema. Todos são
# sobrescrevíveis porque os testes de concorrência precisam andar em
# milissegundos SEM trocar o mecanismo por um relógio falso.
#
# OUTBOX_MAX_ATTEMPTS não é ponto de desistência (D-042, que emenda D-008): é o
# teto do expoente do backoff — a curva já satura em OUTBOX_MAX_DELAY_MS — e o
# limiar de alerta. Todo evento gravado na mesma transação SQL do dinheiro
# continua sendo reivindicado até sair, porque desistir dele quebraria a
# invariante de D-034 de que toda transação aplicada tem evento.
OUTBOX_BASE_DELAY_MS=1000
OUTBOX_MAX_DELAY_MS=300000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=1000

# Filas de ENTRADA (§10 do enunciado). Estes dois nomes nao foram decisao do
# candidato — o enunciado os escreve literalmente. A DLQ recebe por DOIS
# caminhos, e os dois sao esperados: o envio explicito do consumidor quando o
# erro e permanente (D-046), e a redrive policy do SQS quando um erro
# transitorio esgota CONSUMER_MAX_RECEIVE_COUNT entregas.
# Ninguem precisa cria-las a mao: o consumidor provisiona as duas — com a
# redrive policy — pelo mesmo ensureQueue do worker da outbox (D-041).
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo

# Consumidor SQS (D-008, D-022, D-046).
#
# A curva de backoff e a MESMA da outbox — uma formula so, em backoffDelayMs
# (D-008) — com numeros proprios: os dois loops falham por motivos diferentes
# (SQS fora contra PostgreSQL fora) e nada obriga a mesma cadencia.
#
# CONSUMER_MAX_RECEIVE_COUNT e o maxReceiveCount da redrive policy, e cobre so o
# erro transitorio que nao cede: o permanente vai a DLQ na primeira entrega, sem
# gastar as cinco (D-046). Numa fila FIFO isso importa — mensagem presa bloqueia
# o MessageGroupId inteiro e atrasa agregados sem relacao nenhuma com o defeito.
#
# CONSUMER_VISIBILITY_TIMEOUT_SEC precisa cobrir a transacao financeira inteira
# com folga: vencendo no meio, o SQS reentrega enquanto a primeira ainda
# processa, e a segunda entrega gasta uma tentativa contra a inbox sem
# necessidade.
#
# CONSUMER_WAIT_TIME_SEC e o unico parametro em que zero e configuracao VALIDA:
# e a forma documentada de desligar o long polling. Os demais recusam zero e
# caem no default, porque zero ali e configuracao quebrada.
CONSUMER_MAX_RECEIVE_COUNT=5
CONSUMER_VISIBILITY_TIMEOUT_SEC=30
CONSUMER_WAIT_TIME_SEC=20
CONSUMER_BATCH_SIZE=10
CONSUMER_BASE_DELAY_MS=1000
CONSUMER_MAX_DELAY_MS=300000