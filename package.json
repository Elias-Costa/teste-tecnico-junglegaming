{
  "name": "wagering-processor",
  "version": "0.0.0",
  "private": true,
  "description": "Distributed Wagering Processor — desafio técnico Jungle Gaming",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:concurrency": "bun test tests/concurrency",
    "check": "bun run typecheck && bun run lint && bun run test:unit",
    "check:full": "bun run check && bun test --preload ./tests/support/testcontainers-setup.ts tests/integration tests/concurrency"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1123.0",
    "@mikro-orm/core": "7.1.14",
    "@mikro-orm/migrations": "7.1.14",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.1.14",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mikro-orm/cli": "7.1.14",
    "@nestjs/testing": "12.0.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "testcontainers": "12.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
